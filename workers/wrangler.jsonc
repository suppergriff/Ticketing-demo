{
  "$schema": "https://json.schemastore.org/wrangler.json",
  "name": "dynamic-ticket-worker",
  "main": "dynamic-ticket-worker.js",
  "compatibility_date": "2026-09-15",
  "observability": {
    "enabled": true
  },
  "kv_namespaces": [
    {
      "binding": "TICKETS_KV",
      // Replace with the namespace id from the Cloudflare dashboard before connecting this repo.
      "id": "YOUR_KV_NAMESPACE_ID"
    }
  ],
  "routes": [
    {
      "pattern": "ticket-01.griffhu.top/ticket-dynamic*",
      "zone_name": "griffhu.top"
    }
  ]
}
