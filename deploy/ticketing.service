[Unit]
Description=NEXUS GATE ticketing demo (Express) — legacy home-dir unit
After=network.target

# Prefer deploy/ticketing-demo.service (/opt/ticketing-demo) for production.
# Keep this file only as a reference for a non-/opt layout.

[Service]
Type=simple
User=ec2-user
Group=ec2-user
WorkingDirectory=/home/ec2-user/Ticketing-demo
EnvironmentFile=/home/ec2-user/Ticketing-demo/.env
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=3

AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
