# Origin
PORT=8787
ORIGIN_FRAGILE=1
REQUEST_TIMEOUT_MS=3000
# /api/checkout sync CPU burn (ms). Empty = 200 when ORIGIN_FRAGILE=1, else 0.
CHECKOUT_BURN_MS=200
# V1 IP rate limit per 10s. 0 = off (use for single-host k6). Default 8.
IP_RATE_LIMIT=0

# Turnstile (official dummy keys: browser always passes, bots without token always fail)
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Seed
SEED_COUNT=10000
SEED_CONCURRENCY=6
FORCE_REGENERATE=0

# Scene 2 Stage 2 — R2 public custom domain (no trailing slash)
R2_PUBLIC_BASE_URL=https://r2-tickets.yourdomain.com

# Optional: S3-compatible upload during seed
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=tickets-bucket
R2_UPLOAD=0

# k6
BASE_URL=http://127.0.0.1:8787
TICKET_MAX=200
